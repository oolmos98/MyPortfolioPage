---
import { ClientRouter } from "astro:transitions";
import BackToTop from "../components/BackToTop.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SearchModal from "../components/SearchModal.astro";
import "../styles/global.css";

const { title, description } = Astro.props.frontmatter ?? Astro.props;
const headings = Astro.props.headings ?? [];

const wikiArticles = [
  {
    slug: "platform-engineering",
    title: "Platform engineering",
    href: "/wiki/platform-engineering/",
  },
  {
    slug: "secure-delivery",
    title: "Secure delivery",
    href: "/wiki/secure-delivery/",
  },
  {
    slug: "observability-collaboration",
    title: "Observability and collaboration",
    href: "/wiki/observability-collaboration/",
  },
  {
    slug: "spring-boot-rosa",
    title: "Spring Boot on ROSA",
    href: "/wiki/spring-boot-rosa/",
  },
  {
    slug: "earlier-experience",
    title: "Earlier experience",
    href: "/wiki/earlier-experience/",
  },
  {
    slug: "ai-assisted-engineering",
    title: "AI-assisted engineering",
    href: "/wiki/ai-assisted-engineering/",
  },
  {
    slug: "principles",
    title: "Working principles",
    href: "/wiki/principles/",
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isIndex = currentPath === "/wiki" || currentPath === "";
const currentIndex = wikiArticles.findIndex(
  (art) => currentPath === art.href.replace(/\/$/, "") || currentPath.endsWith(art.slug),
);

const prevArticle = currentIndex > 0 ? wikiArticles[currentIndex - 1] : null;
const nextArticle =
  currentIndex >= 0 && currentIndex < wikiArticles.length - 1
    ? wikiArticles[currentIndex + 1]
    : null;

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://www.omarolmos.com",
).toString();
const ogImageUrl = new URL("/og-image.png", Astro.site ?? "https://www.omarolmos.com").toString();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={isIndex ? "website" : "article"} />
    <meta property="og:site_name" content="Omar Olmos" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Omar Olmos`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | Omar Olmos`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} | Omar Olmos</title>
  </head>
  <body id="top" class="wiki-page">
    <div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <header class="site-header">
      <a class="wordmark" href="/" transition:name="site-wordmark">
        OO<span>.</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/wiki/">Wiki</a>
        <a href="/#work">Work</a>
        <button type="button" class="search-trigger" aria-label="Open search">
          Search <span class="search-kbd">⌘K</span>
        </button>
        <a
          class="nav-contact"
          href="https://www.linkedin.com/in/oolmos/"
          target="_blank"
          rel="noreferrer"
        >
          Let's connect <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main-content" class="wiki-shell">
      <div class="wiki-navigation">
        <a class="wiki-back" href="/wiki/">
          ← Back to wiki
        </a>
        <a class="wiki-back" href="/">
          Portfolio ↗
        </a>
      </div>
      {!isIndex && (
        <div class="wiki-meta">
          <span>Engineering Note</span>
          <span>·</span>
          <span class="read-time">~2 min read</span>
        </div>
      )}
      {!isIndex && <TableOfContents headings={headings} />}
      <article class="wiki-content">
        <slot />
      </article>

      {!isIndex && (prevArticle || nextArticle) && (
        <nav class="wiki-pager" aria-label="Article navigation">
          {prevArticle ? (
            <a class="pager-card prev" href={prevArticle.href}>
              <span class="pager-direction">← Previous article</span>
              <span class="pager-title">{prevArticle.title}</span>
            </a>
          ) : (
            <div />
          )}
          {nextArticle && (
            <a class="pager-card next" href={nextArticle.href}>
              <span class="pager-direction">Next article →</span>
              <span class="pager-title">{nextArticle.title}</span>
            </a>
          )}
        </nav>
      )}

      <footer class="wiki-footer">
        <span>Omar Olmos / 2026</span>
        <a href="#top">Back to top ↑</a>
      </footer>
    </main>

    <SearchModal />
    <BackToTop />

    <script>
      const setupCopyButtons = () => {
        document.querySelectorAll(".wiki-content pre").forEach((pre) => {
          if (pre.querySelector(".copy-code-btn")) return;
          const btn = document.createElement("button");
          btn.className = "copy-code-btn";
          btn.type = "button";
          btn.setAttribute("aria-label", "Copy code snippet");
          btn.textContent = "Copy";
          btn.addEventListener("click", async () => {
            const code = pre.querySelector("code")?.textContent || pre.textContent || "";
            try {
              await navigator.clipboard.writeText(code);
              btn.textContent = "Copied!";
              btn.classList.add("copied");
              setTimeout(() => {
                btn.textContent = "Copy";
                btn.classList.remove("copied");
              }, 2000);
            } catch (err) {
              console.error("Failed to copy:", err);
            }
          });
          pre.appendChild(btn);
        });
      };

      const updateReadingProgress = () => {
        const bar = document.getElementById("reading-progress");
        if (!bar) return;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollHeight <= 0) {
          bar.style.transform = "scaleX(0)";
          return;
        }
        const progress = Math.min(1, Math.max(0, window.scrollY / scrollHeight));
        bar.style.transform = `scaleX(${progress})`;
      };

      window.addEventListener("scroll", updateReadingProgress, { passive: true });
      document.addEventListener("astro:page-load", () => {
        setupCopyButtons();
        updateReadingProgress();
      });
      setupCopyButtons();
      updateReadingProgress();
    </script>
  </body>
</html>
