---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import InteractiveSkills from "../components/InteractiveSkills.jsx";
import BackToTop from "../components/BackToTop.astro";
import SearchModal from "../components/SearchModal.astro";
import FlappyPodModal from "../components/FlappyPodModal.astro";
import portrait from "../assets/img/IMG_1666.jpg";
import "../styles/global.css";

const projects = [
  {
    number: "01",
    title: "Spring Boot on ROSA",
    text: "How I configure JVM memory bounds, separate liveness and readiness probes, size HikariCP pools, and handle zero-downtime rolling updates on OpenShift.",
    tags: ["Java", "Spring Boot", "ROSA", "Argo CD"],
    href: "/wiki/spring-boot-rosa/",
  },
  {
    number: "02",
    title: "Platform engineering & GitOps",
    text: "Structuring multi-AZ AWS foundations, ROSA compute pools, Argo CD drift reconciliation, and clear boundaries between platform and application teams.",
    tags: ["AWS", "Kubernetes", "OpenShift", "Aurora PostgreSQL"],
    href: "/wiki/platform-engineering/",
  },
  {
    number: "03",
    title: "Pull-based CI/CD & release security",
    text: "Running GitLab CI, Snyk scanning, and OIDC federation so pipelines commit signed image digests to Git instead of holding cluster admin credentials.",
    tags: ["GitLab CI", "Snyk", "OIDC", "GitOps"],
    href: "/wiki/secure-delivery/",
  },
  {
    number: "04",
    title: "Observability & incident handoffs",
    text: "Connecting Dynatrace distributed traces to Slack triage, Jira follow-ups, and Confluence runbooks when things break in production.",
    tags: ["Dynatrace", "SRE", "Slack", "Confluence"],
    href: "/wiki/observability-collaboration/",
  },
];

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://www.omarolmos.com",
).toString();
const ogImageUrl = new URL("/og-image.png", Astro.site ?? "https://www.omarolmos.com").toString();
const pageDescription =
  "Omar Olmos — Lead Software Engineer working on Java, Spring Boot, AWS, ROSA/OpenShift, Argo CD GitOps, and production reliability.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omar Olmos" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Omar Olmos | Lead Software Engineer" />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content="Omar Olmos | Lead Software Engineer" />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
    <link rel="icon" href="/favicon.svg" />
    <title>Omar Olmos | Lead Software Engineer</title>
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <div class="page-noise" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="/" transition:name="site-wordmark">
        OO<span>.</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Notes</a>
        <a href="#capabilities">Stack</a>
        <a href="/wiki/">Wiki</a>
        <button type="button" class="search-trigger" aria-label="Open search">
          Search <span class="search-kbd">⌘K</span>
        </button>
        <a
          class="nav-contact"
          href="https://www.linkedin.com/in/oolmos/"
          target="_blank"
          rel="noreferrer"
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero section-wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Omar Olmos · Lead Software Engineer · California</p>
          <h1 id="hero-title">Backend services, OpenShift platforms, and production delivery.</h1>
          <p class="hero-summary">
            I’m a Lead Software Engineer at State Farm. Most of my day-to-day work lives at the
            intersection of Java and Spring Boot applications, AWS and ROSA (OpenShift) clusters,
            Argo CD GitOps pipelines, and production observability.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/wiki/">
              Read the engineering wiki <span aria-hidden="true">→</span>
            </a>
            <a
              class="text-link"
              href="https://github.com/oolmos98"
              target="_blank"
              rel="noreferrer"
            >
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="hero-portrait">
          <figure class="portrait-figure">
            <div class="portrait-frame">
              <Image
                src={portrait}
                alt="Omar and his wife at the coast"
                width={620}
                height={760}
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption>Left: my wife. Right: me.</figcaption>
          </figure>
        </div>
      </section>

      <section class="intro-band section-wrap" aria-label="Background">
        <p class="section-kicker">Background</p>
        <div class="intro-statement">
          Writing the service code is only half the job. The rest is making sure it deploys cleanly,
          survives bad traffic, and doesn’t wake people up at 2 a.m.
        </div>
        <div class="intro-details">
          <p>
            Over the years I’ve worked across mobile apps, relational databases, legacy Java stacks,
            and cloud infrastructure. Right now I focus on Spring Boot and GraphQL services running
            on Red Hat OpenShift Service on AWS (ROSA), backed by Aurora PostgreSQL and Entra ID.
          </p>
          <p>
            Instead of a traditional blog, I keep a working <a href="/wiki/">engineering wiki</a> on
            this site. It documents how I set up GitOps pipelines, tune Kubernetes probes, trace
            production issues in Dynatrace, and use tools like Claude and Codex without leaving a
            mess for the next engineer on call.
          </p>
        </div>
      </section>

      <section class="work-section section-wrap" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Field notes</p>
            <h2 id="work-title">Architecture &amp; operations</h2>
          </div>
          <a class="text-link" href="/wiki/">
            All 7 notes →
          </a>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <a class="project-row" href={project.href}>
              <span class="project-number">{project.number}</span>
              <div class="project-content">
                <h3>{project.title}</h3>
                <p>{project.text}</p>
                <div class="tag-list">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>
              <span class="project-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      </section>

      <section
        class="capabilities-section section-wrap"
        id="capabilities"
        aria-labelledby="capabilities-title"
      >
        <div class="section-heading">
          <div>
            <p class="section-kicker">Stack &amp; tooling</p>
            <h2 id="capabilities-title">What I work with</h2>
          </div>
        </div>
        <InteractiveSkills />
      </section>

      <section class="contact-section section-wrap" aria-labelledby="contact-title">
        <p class="section-kicker">Contact</p>
        <h2 id="contact-title">Get in touch</h2>
        <p class="contact-lead">
          Always happy to talk shop about platform engineering, OpenShift/Kubernetes operations, or
          backend architecture.
        </p>
        <a
          class="contact-email"
          href="https://www.linkedin.com/in/oolmos/"
          target="_blank"
          rel="noreferrer"
        >
          linkedin.com/in/oolmos <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-footer">
          <span>Omar Olmos · 2026</span>
          <div>
            <button type="button" class="flappy-trigger" data-open-flappy>
              [Flappy Pod]
            </button>
            <a href="/wiki/">Wiki</a>
            <a href="https://www.linkedin.com/in/oolmos/" target="_blank" rel="noreferrer">
              LinkedIn
            </a>
            <a href="https://github.com/oolmos98" target="_blank" rel="noreferrer">
              GitHub
            </a>
            <a href="#top">Top ↑</a>
          </div>
        </div>
      </section>
    </main>
    <SearchModal />
    <FlappyPodModal />
    <BackToTop />
  </body>
</html>
