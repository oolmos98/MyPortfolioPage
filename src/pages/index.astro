---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import InteractiveSkills from "../components/InteractiveSkills.jsx";
import BackToTop from "../components/BackToTop.astro";
import SearchModal from "../components/SearchModal.astro";
import portrait from "../assets/img/IMG_1666.jpg";
import "../styles/global.css";

const projects = [
  {
    number: "01",
    title: "Secure services on the platform",
    text: "Spring Boot services designed around clear contracts, Entra ID authentication, and data workflows that stay understandable as systems grow.",
    tags: ["Java", "Spring Boot", "GraphQL", "Entra ID"],
    href: "/wiki/spring-boot-rosa/",
  },
  {
    number: "02",
    title: "Delivery without the drama",
    text: "GitLab CI, Snyk, Argo CD, Dynatrace, Kubernetes, and ROSA practices that make shipping repeatable, secure, observable, and less fragile.",
    tags: ["ROSA", "Argo CD", "GitLab CI"],
    href: "/wiki/secure-delivery/",
  },
];

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://www.omarolmos.com",
).toString();
const ogImageUrl = new URL("/og-image.png", Astro.site ?? "https://www.omarolmos.com").toString();
const pageDescription =
  "The portfolio and engineering wiki of Omar Olmos, a software engineer focused on platform architecture, systems engineering, and operational reliability.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omar Olmos" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Omar Olmos | Software Engineer" />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content="Omar Olmos | Software Engineer" />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
    <link rel="icon" href="/favicon.svg" />
    <title>Omar Olmos | Software Engineer</title>
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <div class="page-noise" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="/" transition:name="site-wordmark">
        OO<span>.</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#capabilities">Capabilities</a>
        <a href="/wiki/">Wiki</a>
        <button type="button" class="search-trigger" aria-label="Open search">
          Search <span class="search-kbd">⌘K</span>
        </button>
        <a
          class="nav-contact"
          href="https://www.linkedin.com/in/oolmos/"
          target="_blank"
          rel="noreferrer"
        >
          Let's connect <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero section-wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Software engineer / California</p>
          <h1 id="hero-title">
            Reliable platforms,
            <br />
            <em>thoughtfully built.</em>
          </h1>
          <p class="hero-summary">
            I build software across Java services, cloud platforms, secure delivery, and the
            operational practices that keep systems dependable in production.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">
              See selected work <span aria-hidden="true">↓</span>
            </a>
            <a
              class="text-link"
              href="https://github.com/oolmos98"
              target="_blank"
              rel="noreferrer"
            >
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="hero-portrait">
          <figure class="portrait-figure">
            <div class="portrait-frame">
              <Image
                src={portrait}
                alt="Omar and his wife at the coast"
                width={620}
                height={760}
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption>Left: my wife. Right: Omar.</figcaption>
          </figure>
        </div>
        <div class="hero-index" aria-hidden="true">
          01 / 04
        </div>
      </section>

      <section class="intro-band section-wrap" aria-label="Introduction" data-reveal>
        <p class="section-kicker">A little context</p>
        <div class="intro-statement">
          I connect <span>application engineering</span>, platform reliability, security, and
          practical AI-assisted delivery so teams can move from an idea to a dependable production
          system.
        </div>
        <div class="intro-details">
          <p>
            My current focus is Java and Spring Boot on AWS and Red Hat OpenShift Service on AWS
            (ROSA), with Kubernetes deployment patterns, Argo CD GitOps delivery, GitLab CI
            automation, Snyk security checks, Microsoft Entra ID authentication, Amazon Aurora
            PostgreSQL, GraphQL, and Dynatrace observability.
          </p>
          <p>
            Good engineering should be clear to use, observable in production, and easy for the next
            team to change. I use Slack, Jira, and Confluence to keep communication, decisions, and
            delivery visible.
          </p>
        </div>
      </section>

      <section class="work-section section-wrap" id="work" aria-labelledby="work-title" data-reveal>
        <div class="section-heading">
          <div>
            <p class="section-kicker">What I do</p>
            <h2 id="work-title">
              Systems people
              <br />
              <em>can rely on.</em>
            </h2>
          </div>
          <span class="section-count">02 / 04</span>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <a class="project-row" href={project.href} data-reveal>
              <span class="project-number">{project.number}</span>
              <div class="project-content">
                <h3>{project.title}</h3>
                <p>{project.text}</p>
                <div class="tag-list">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>
              <span class="project-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </section>

      <section
        class="capabilities-section section-wrap"
        id="capabilities"
        aria-labelledby="capabilities-title"
        data-reveal
      >
        <div class="section-heading">
          <div>
            <p class="section-kicker">Technical capabilities</p>
            <h2 id="capabilities-title">
              From code
              <br />
              <em>to production.</em>
            </h2>
          </div>
          <span class="section-count">03 / 04</span>
        </div>
        <InteractiveSkills client:visible />
      </section>

      <section class="contact-section section-wrap" aria-labelledby="contact-title" data-reveal>
        <p class="section-kicker">Start a conversation</p>
        <h2 id="contact-title">
          Let's build
          <br />
          <em>something dependable.</em>
        </h2>
        <span class="section-count contact-count">04 / 04</span>
        <a
          class="contact-email"
          href="https://www.linkedin.com/in/oolmos/"
          target="_blank"
          rel="noreferrer"
        >
          Connect on LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-footer">
          <span>Omar Olmos / 2026</span>
          <div>
            <a href="https://www.linkedin.com/in/oolmos/" target="_blank" rel="noreferrer">
              LinkedIn
            </a>
            <a href="https://github.com/oolmos98" target="_blank" rel="noreferrer">
              GitHub
            </a>
            <a href="#top">Back to top ↑</a>
          </div>
        </div>
      </section>
    </main>
    <SearchModal />
    <BackToTop />
    <script>
      const revealOnScroll = () => {
        const items = document.querySelectorAll("[data-reveal]");
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          items.forEach((item) => item.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );

        items.forEach((item) => observer.observe(item));
      };

      document.addEventListener("astro:page-load", revealOnScroll);
      revealOnScroll();
    </script>
  </body>
</html>
