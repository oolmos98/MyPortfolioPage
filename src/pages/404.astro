---
import { ClientRouter } from "astro:transitions";
import SearchModal from "../components/SearchModal.astro";
import BackToTop from "../components/BackToTop.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Page not found | Omar Olmos" />
    <meta name="robots" content="noindex, nofollow" />
    <ClientRouter />
    <link rel="icon" href="/favicon.svg" />
    <title>404: Not Found | Omar Olmos</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <div class="page-noise" aria-hidden="true"></div>

    <header class="site-header">
      <a class="wordmark" href="/" transition:name="site-wordmark">
        OO<span>.</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/wiki/">Wiki</a>
        <button type="button" class="search-trigger" aria-label="Search site">
          Search <span class="search-kbd">⌘K</span>
        </button>
      </nav>
    </header>

    <main id="main-content" class="section-wrap not-found-section">
      <div class="not-found-code">
        404<span>.</span>
      </div>
      <h1 class="not-found-title">Page not found</h1>
      <p class="not-found-text">
        The page or engineering note you were looking for doesn't exist, was moved, or had its URL
        updated.
      </p>
      <div class="not-found-actions">
        <a href="/" class="button button-primary">
          Return home <span aria-hidden="true">→</span>
        </a>
        <a href="/wiki/" class="button" style="border: 1px solid var(--ink);">
          Browse Wiki <span aria-hidden="true">↗</span>
        </a>
        <button type="button" class="search-trigger" aria-label="Open search">
          Search notes <span class="search-kbd">⌘K</span>
        </button>
      </div>
    </main>

    <SearchModal />
    <BackToTop />
  </body>
</html>
